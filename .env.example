# Copie este arquivo para ".env" e ajuste os valores.

# ---------- Servidor ----------
NODE_ENV=production
PORT=3000
# Endereço público do sistema (usado em links)
APP_URL=http://localhost:3000
# Fuso horário da barbearia
TZ=America/Sao_Paulo

# Em produção com HTTPS (recomendado): cookies "secure"
COOKIE_SECURE=false
# true se estiver atrás de proxy reverso (Nginx, Caddy, Cloudflare...)
TRUST_PROXY=false
SESSION_DAYS=7

# ---------- Banco de dados e arquivos ----------
DB_PATH=data/barbearia.db
BACKUP_DIR=data/backups
UPLOAD_DIR=data/uploads
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# ---------- Administrador inicial (usado apenas na primeira execução) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@barbearia.local
# Deixe vazio para gerar uma senha aleatória (exibida no terminal)
ADMIN_PASSWORD=

# ---------- E-mail (SMTP) ----------
# Sem SMTP_HOST, os e-mails ficam apenas registrados em Configurações > E-mails enviados.
# Exemplo Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 + "senha de app" da conta Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barbearia 30 de Maio <no-reply@seudominio.com.br>"
