{
  "name": "barbearia-30-de-maio",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão e agendamento para barbearia",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server/src --disable-warning=ExperimentalWarning server/src/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/src/db/seed.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/src/db/seed.js --demo",
    "backup": "node --disable-warning=ExperimentalWarning server/src/db/backup-cli.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.6"
  }
}
